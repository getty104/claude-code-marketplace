{
  "description": "BW_ 系の環境変数の出力・送信を防ぎ、BW_SESSION がない場合は bw を実行させない",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bw-env.cjs\""
          }
        ]
      }
    ]
  }
}
