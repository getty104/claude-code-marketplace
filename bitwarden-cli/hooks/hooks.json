{
  "description": "クラウドセッションでは bw をインストールし、BW_ 系の環境変数の出力・送信を防ぎ、BW_PASSWORD がない場合は bw を実行させない",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/install-bw.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bw-env.cjs\""
          }
        ]
      }
    ]
  }
}
